# Server Port
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Connection String
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://finora_user:finora_password@localhost:5432/finora_db?schema=public

# JWT Configuration
JWT_SECRET=super_secret_finora_jwt_key_development_2026_finance_dashboard
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
